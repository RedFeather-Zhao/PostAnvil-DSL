// ============================================================
//  PostAnvil 规则脚本 — 麦穗邻近区分后处理
// ============================================================

// 密度得分：统计与当前麦穗相关联的目标数量及平均 IoU。
RULE FUNC density_score(spike: INST) -> NUM:
    NUM count = 0
    NUM total_iou = 0

    FOR obj IN "All-Spikelet"
        NUM overlap = _IOU(spike, obj)
        IF overlap > 0.3
            count = count + 1
            total_iou = total_iou + overlap
        ENDIF
    ENDFOR

    FOR obj IN "Spikelet"
        IF _CONTAINS(obj, spike)
            count = count + 1
        ENDIF
    ENDFOR

    FOR obj IN "Sterile-Spikelet"
        IF _CONTAINS(obj, spike)
            count = count + 1
        ENDIF
    ENDFOR

    FOR obj IN "Awn"
        NUM overlap = _IOU(spike, obj)
        IF overlap > 0.1 OR _NEARBY(spike, obj, 50)
            count = count + 1
            total_iou = total_iou + overlap
        ENDIF
    ENDFOR

    NUM iou_score = 0
    IF count > 0
        iou_score = total_iou / count
    ENDIF

    NUM count_score = _MIN(1, count / 10)
    RETURN count_score * 0.6 + iou_score * 0.4
RULEEND

// 层级结构得分：检查与麦穗关联的子目标是否存在。
RULE FUNC hierarchy_score(spike: INST) -> NUM:
    NUM score = 0
    BOOL has_all_spikelet = FALSE
    BOOL has_awn = FALSE
    NUM spikelet_count = 0
    NUM sterile_count = 0

    FOR obj IN "All-Spikelet"
        IF _IOU(spike, obj) >= 0.6 OR _CONTAINS(obj, spike)
            has_all_spikelet = TRUE
        ENDIF
    ENDFOR

    FOR obj IN "Spikelet"
        IF _CONTAINS(obj, spike)
            spikelet_count = spikelet_count + 1
        ENDIF
    ENDFOR

    FOR obj IN "Awn"
        IF _IOU(spike, obj) > 0.1 OR _NEARBY(spike, obj, 50)
            has_awn = TRUE
        ENDIF
    ENDFOR

    FOR obj IN "Sterile-Spikelet"
        IF _CONTAINS(obj, spike)
            sterile_count = sterile_count + 1
        ENDIF
    ENDFOR

    IF has_all_spikelet
        score = score + 0.4
    ENDIF
    IF spikelet_count > 0
        score = score + 0.3 * _MIN(1, spikelet_count / 5)
    ENDIF
    IF has_awn
        score = score + 0.2
    ENDIF
    IF sterile_count > 0
        score = score + 0.1 * _MIN(1, sterile_count / 3)
    ENDIF

    RETURN score
RULEEND

// 中心性得分：检测框距离图像中心越近，得分越高。
RULE FUNC center_score(spike: INST) -> NUM:
    NUM dx = (spike.cx - img.w / 2) / img.w
    NUM dy = (spike.cy - img.h / 2) / img.h
    NUM normalized_distance = _SQRT(_POW(dx, 2) + _POW(dy, 2))
    RETURN _MAX(0, 1 - normalized_distance * 2)
RULEEND

// 为每个麦穗计算综合得分。
RULE ATTR "Spike":
    self.center_score = center_score(self)
    self.density_score = density_score(self)
    self.hierarchy_score = hierarchy_score(self)
    self.total_score = self.center_score * 0.20 + self.density_score * 0.30 + self.hierarchy_score * 0.50
RULEEND

// 按综合得分原地排序；id 作为并列时的确定性排序键。
RULE SORT "Spike":
    self.total_score DESC
    self.id ASC
RULEEND

// 保存排序后的最佳麦穗快照，再精确保留对应逻辑实例。
INST best_spike = _INST_INDEX("Spike", 1)

RULE FILTER "Spike":
    self.id == best_spike.id
RULEEND

RULE FILTER "All-Spikelet":
    _IOU(self, best_spike) >= 0.6 OR _CONTAINS(self, best_spike)
RULEEND

RULE FILTER "Spikelet":
    _CONTAINS(self, best_spike)
RULEEND

RULE FILTER "Sterile-Spikelet":
    _CONTAINS(self, best_spike)
RULEEND

RULE FILTER "Awn":
    _IOU(self, best_spike) > 0.1 OR _NEARBY(self, best_spike, 50)
RULEEND

RULE FILTER "Flag-Leaf":
    _NEARBY(self, best_spike, 100)
RULEEND
